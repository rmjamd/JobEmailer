{
  "manifest_version": 3,
  "name": "LinkedIn Post Sender",
  "version": "1.0",
  "description": "Adds a Sent button to LinkedIn posts in search results",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/search/results/*",
        "https://www.linkedin.com/feed/*",
        "https://www.linkedin.com/my-network/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
